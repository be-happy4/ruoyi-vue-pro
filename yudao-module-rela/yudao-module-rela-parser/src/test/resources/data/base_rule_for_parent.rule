# 父母关系为基础的推导规则集

## 直系关系推导
### select A.*, B.* from person A, person B, relation R
### where A.sex='M' AND R.from_id=A.id AND R.to_id=B.id AND (R.type='父亲' OR R.type='母亲');
### insert into relation(from_id, to_id, type) values (A.id, B.id, '儿子');
A.sex='M' AND (A.父亲=B OR A.母亲=B) => B.儿子=A
A.sex='F' AND (A.父亲=B OR A.母亲=B) => B.女儿=A
A.sex='M' AND (A.父亲=C AND B.父亲=C OR A.母亲=C AND B.母亲=C) AND A.birthDay < B.birthDay => B.哥哥=A
A.sex='F' AND (A.父亲=C AND B.父亲=C OR A.母亲=C AND B.母亲=C) AND A.birthDay < B.birthDay => B.姐姐=A
A.sex='M' AND (A.父亲=C AND B.父亲=C OR A.母亲=C AND B.母亲=C) AND A.birthDay > B.birthDay => B.弟弟=A
A.sex='F' AND (A.父亲=C AND B.父亲=C OR A.母亲=C AND B.母亲=C) AND A.birthDay > B.birthDay => B.妹妹=A
A.父亲=B OR A.母亲=C => B.妻子=A, C.丈夫=B

A.父亲=B AND B.父亲=C => A.爷爷=C
A.父亲=B AND B.母亲=C => A.奶奶=C
A.母亲=B AND B.父亲=C => A.外公=C
A.母亲=B AND B.母亲=C => A.外婆=C

A.sex='M' AND A.父亲=B AND (B.父亲=C OR B.母亲=C) => C.孙子=A
A.sex='F' AND A.父亲=B AND (B.父亲=C OR B.母亲=C) => C.孙女=A
A.sex='M' AND A.母亲=B AND (B.父亲=C OR B.母亲=C) => C.外孙子=A
A.sex='F' AND A.母亲=B AND (B.父亲=C OR B.母亲=C) => C.外孙女=A


